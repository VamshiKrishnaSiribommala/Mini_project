# LungXpert Environment Configuration Example
# Copy this file to .env to customize local execution settings

# Server Configuration
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
DEBUG=False

# Compute Device (options: cpu, cuda, cuda:0)
DEVICE=cpu

# Optional Cloud / Third-Party Logging API Keys (Leave blank for full local offline inference)
GEMINI_API_KEY=
WANDB_API_KEY=
